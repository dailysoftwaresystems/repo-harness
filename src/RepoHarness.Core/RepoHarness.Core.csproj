<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RepoHarness.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The registry document's edits are internal: each takes the row positions read when the
         file was parsed, which only the service that just parsed it can vouch for. -->
    <InternalsVisibleTo Include="repo-harness-test" />
  </ItemGroup>

  <ItemGroup>
    <!-- The skeleton init writes for a new anchor registry. Embedded so it travels inside the
         assembly and can never be missing or out of step with the code that reads it. -->
    <None Remove="Anchors/Templates/anchor-registry.md" />
    <EmbeddedResource Include="Anchors/Templates/anchor-registry.md"
                      LogicalName="RepoHarness.Core.Anchors.Templates.anchor-registry.md" />
  </ItemGroup>

</Project>
