# Build output. Every build writes under build/ (see Directory.Build.props), so this
# one entry covers binaries, intermediates and packages alike.
/build/

# IDE
.vs/
.idea/
*.user
*.suo

# Test results
TestResults/
*.trx
*.coverage

# NuGet: a package packed to anywhere other than build/ is still never committed
*.nupkg

# OS
.DS_Store
Thumbs.db

# DssHarness runtime state (generated by `DssHarness init` in consuming repos)
/.harness-config/lock.json
/.harness-config/runs/
/.harness-config/worktrees/*
!/.harness-config/worktrees/.gitkeep

# Connection data: one directory per ssh host and per WSL distribution, each holding an
# address, a user and a key. Nothing under either is ever tracked.
/.harness-config/sshItems/*
!/.harness-config/sshItems/.gitkeep
/.harness-config/wslDistros/*
!/.harness-config/wslDistros/.gitkeep

# Runner action files are tracked; the values they read are not.
/.harness-config/runner/.env/*
!/.harness-config/runner/.env/.gitkeep
/.harness-config/runner/.secrets/*
!/.harness-config/runner/.secrets/.gitkeep

# Claude Code local state (per-user settings, agent worktrees)
.claude/
