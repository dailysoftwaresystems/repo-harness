# Build output. Every build writes under build/ (see Directory.Build.props), so this
# one entry covers binaries, intermediates and packages alike.
/build/

# IDE
.vs/
.idea/
*.user
*.suo

# Test results
TestResults/
*.trx
*.coverage

# NuGet: a package packed to anywhere other than build/ is still never committed
*.nupkg

# OS
.DS_Store
Thumbs.db

# DssHarness runtime state (generated by `DssHarness init` in consuming repos)
/.harness-config/lock.json
/.harness-config/worktrees/*
!/.harness-config/worktrees/.gitkeep
/.harness-config/ssh/*
!/.harness-config/ssh/.gitkeep

# Claude Code local state (per-user settings, agent worktrees)
.claude/
